# Copy to gitignored .ttq-local.env for an authorized Supabase target.
# Never commit real credentials or use production accounts for destructive tests.
TTQ_AUTH_MODE=supabase
TTQ_DATABASE_MODE=postgres
TTQ_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
TTQ_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Generate a fresh random value; never reuse the original project's secret.
TTQ_INTERNAL_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Supabase pooler connection using the ttq_app backend role (not postgres).
# Percent-encode passwords. Use the Connect dialog to confirm pooler hostname.
TTQ_DATABASE_URL=postgresql://ttq_app.YOUR_PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Optional PEM root CA if your database certificate requires it. Never turn off verification.
# TTQ_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Exact public HTTPS origin, e.g. https://your-site.netlify.app
TTQ_ALLOWED_ORIGINS=https://YOUR_SITE.netlify.app

# LOCAL MIGRATION TOOL ONLY. NEVER upload these to Netlify or include in frontend.
# TTQ_DATABASE_ADMIN_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:5432/postgres
# TTQ_TEST_PROJECT_REF=YOUR_PROJECT_REF
# TTQ_APP_DATABASE_PASSWORD=FRESH_LONG_RANDOM_PASSWORD
