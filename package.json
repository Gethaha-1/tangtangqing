{
  "name": "tangtangqing-netlify-supabase",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:ledger": "node scripts/prepare-ledger-assets.mjs",
    "dev": "node scripts/next-with-local-env.mjs dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "npm run prepare:ledger && node scripts/next-with-local-env.mjs build",
    "start": "node scripts/next-with-local-env.mjs start",
    "test": "node --import tsx --test tests/*.test.js tests/*.test.mjs",
    "test:domain": "node --test tests/domain.test.js",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/ledger --ignore-pattern .netlify",
    "test:postgres": "node --import tsx --test tests/postgres-integration.test.mjs",
    "test:auth": "node --import tsx --test tests/supabase-auth.test.mjs",
    "build:netlify": "netlify build --offline --context production",
    "prepare:netlify:deploy": "node scripts/prepare-netlify-manual-deploy.mjs",
    "deploy:netlify:draft": "npm run build:netlify && npm run prepare:netlify:deploy && netlify deploy --no-build --dir .netlify/static --functions .netlify/functions-internal",
    "deploy:netlify:prod": "npm run build:netlify && npm run prepare:netlify:deploy && netlify deploy --no-build --dir .netlify/static --functions .netlify/functions-internal --prod",
    "db:setup:supabase": "node --env-file=.ttq-local.env --import tsx scripts/setup-supabase.mjs",
    "verify:cloud": "node --env-file=.ttq-local.env --import tsx scripts/verify-cloud.mjs",
    "test:http": "npm run build && node --import tsx tests/http-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "5.15.13",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "17.7.0-beta.15",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "netlify-cli": "27.4.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
